8a:["$","p",null,{"children":["Here, - ",["$","code",null,{"children":"q"}]," accumulates the result bits - ",["$","code",null,{"children":"s0"}]," tracks ",["$","code",null,{"children":"2 × q"}]," (avoiding\nmultiplication) - ",["$","code",null,{"children":"r"}]," is the bit position being tested - ",["$","code",null,{"children":"t"}]," represents the\n“cost” of setting the current bit: ",["$","code",null,{"children":"s0 + r"}],". If the remainder ",["$","code",null,{"children":"ix0"}]," is greater\nthan ",["$","code",null,{"children":"t"}],", we can “afford” the bit. We subtract ",["$","code",null,{"children":"t"}]," from our remainder and set\nthe bit in ",["$","code",null,{"children":"q"}],"."]}]
