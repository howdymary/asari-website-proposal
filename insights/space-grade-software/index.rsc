x-1 flex-col gap-4 xl:mx-0 xl:max-w-none","children":[[["$","h1",null,{"id":"what-does-it-take-for-ai-to-build-space-software","children":"What does it take for AI to build space software?"}],"\n",["$","div",null,{"className":"text-content-secondary titlecase font-family-sans text-center","children":"March 26, 2026"}],"\n",["$","div",null,{"className":"text-content-secondary text-center italic","children":"By Asari AI"}],"\n",["$","div",null,{"style":{"width":"100%","margin":"0.5rem 0","textAlign":"center"},"children":["$","video",null,{"src":"/asari-website-proposal/original-asari/assets/blog-visuals/space-grade-software-header.mp4","autoPlay":true,"loop":true,"muted":true,"playsInline":true,"style":{"width":"100%","borderRadius":"8px"}}]}],"\n",["$","p",null,{"children":"On June 4, 1996, the highly anticipated maiden flight of the Ariane 5 rocket was cut short when it self-destructed only 37 seconds after liftoff. The culprit behind the $370 million in damages: an integer overflow in the control software, caused by the conversion of a 64-bit floating point number into a 16-bit signed integer."}],"\n","$L9","\n","$La","\n","$Lb","\n","$Lc","\n","$Ld","\n","$Le","\n","$Lf","\n","$L10","\n","$L11","\n","$L12","\n","$L13","\n","$L14","\n","$L15","\n","$L16","\n","$L17","\n","$L18","\n","$L19","\n","$L1a","\n","$L1b","\n","$L1c","\n","$L1d","\n","$L1e","\n","$L1f"],"$L20"]}],"$L21"]}],null,"$L22"]}],{},null,false]},null,false]},null,false]},null,false],"$L23",false]],"m":"$undefined","G":["$24",[]],"s":false,"S":true}
25:I[55197,["5481","static/chunks/5481-c68eb1cc4b35d9ef.js","4544","static/chunks/4544-ab1545925cd83425.js","8678","static/chunks/8678-560c8a10f6155e61.js","3633","static/chunks/3633-b26d6376701fc823.js","9938","static/chunks/app/blog/space-grade-software/page-c98e0490975deaa6.js"],"default"]
