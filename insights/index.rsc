8:["$","$L13",null,{"blogPosts":[{"title":"Speeding up end-to-end inference with self-improving agents","date":"July 28, 2026","category":"engineering","excerpt":"Early results on how our co-inventor agents improve the full AI inference stack using a rigorous self-improving process.","slug":"inference-optimization","author":"Asari AI","thumbnail":"/asari-website-proposal/original-asari/assets/blog-visuals/datacenter-optimization-thumb.svg"},{"title":"What does it take for AI to build space software?","date":"March 26, 2026","category":"explainer","excerpt":"Building software for space leaves zero margin for error. We explore what it took for our AI agents to migrate the space-grade math library libmcs from C to Safe Rust, preserving bit-level precision guarantees and catching subtle issues that even expert reviewers missed.","slug":"space-grade-software","author":"Asari AI","thumbnail":"/asari-website-proposal/original-asari/assets/blog-visuals/space-grade-software-thumb.jpg"},{"title":"Migrating critical systems to Safe Rust with reliable agents","date":"January 29, 2026","category":"engineering","excerpt":"Our AI co-inventor successfully translated critical C libraries to memory-safe Rust, demonstrating a path forward for building AI systems that can tackle complex, high-stakes engineering work as true collaborators.","slug":"migrating-c-to-rust","author":"Asari AI","thumbnail":"/asari-website-proposal/original-asari/assets/blog-visuals/migrating-c-to-rust-thumb.jpg"},{"title":"Enabling intelligent search for AI agents","date":"December 4, 2025","category":"research","excerpt":"We introduce EnCompass, a new framework for LLM-based agents that cleanly separates workflow design from inference-time strategy. By compiling agent workflows into a structured search space, our framework makes it easy to experiment with strategies like tree search and improve reliability with minimal code changes.","slug":"enabling-intelligent-search-for-ai-agents","author":"Zhening Li and others at Asari AI","thumbnail":"/asari-website-proposal/original-asari/assets/blog-visuals/encompass-thumb.jpg"}]}]
