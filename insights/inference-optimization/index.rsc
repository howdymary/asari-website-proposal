49:"$Sreact.suspense"
9:["$","p",null,{"children":["We build co-inventors: self-improving agents that design and optimize high-performance infrastructure. Applied to AI inference, they optimized the entire inference stack for two of the largest open-source LLMs: DeepSeek v4 Pro and GLM 5.2 running on NVIDIA B200s with ",["$","a",null,{"href":"https://vllm.ai/","target":"_blank","rel":"noopener noreferrer","className":"external-link-in-content","children":"vLLM"}]," v0.23. They improved both throughput and interactivity by up to 16% across multiple max-concurrency levels, while preserving model behavior through distribution-level correctness checks. Each concurrency level took the agents about a day to optimize."]}]
a:["$","p",null,{"children":"As of vLLM v0.26, most of the changes made by our agents have no upstream equivalent. The changes span the entire inference stack, including kernels, schedulers, load-balancers, and configuration settings."}]
b:["$","$L38",null,{}]
c:["$","div",null,{"className":"text-content-secondary mt-2 text-center font-family-sans","style":{"fontSize":"0.75rem"},"children":["$","$L39",null,{"id":"1","children":[["$","p",null,{"children":["Throughput and interactivity for an agent-optimized inference stack (blue) and vLLM v0.23 (grey) running on 8 B200s.",["$","$L3a",null,{}]," ",["$","strong",null,{"children":"The agents achieved consistent improvements across the board."}]]}],["$","$L3b",null,{"children":["Absolute throughput and interactivity metric values vary with the client-server configuration and the resulting request patterns and batch sizes. At higher concurrency levels, the measured baseline systematically depends on the choice between ",["$","a",null,{"href":"https://inferencex.semianalysis.com/inference","target":"_blank","rel":"noopener noreferrer","className":"external-link-in-content","children":"InferenceX"}]," or ",["$","a",null,{"href":"https://docs.vllm.ai/en/latest/benchmarking/cli/","target":"_blank","rel":"noopener noreferrer","className":"external-link-in-content","children":"vLLM bench's"}]," default measurement process. Every comparison here is measured against its own matched baseline, and the gains are statistically significant at each level."]}]]}]}]
d:["$","p",null,{"children":["A single fast kernel doesn't make a fast system (",["$","a",null,{"href":"https://en.wikipedia.org/wiki/Amdahl%27s_law","target":"_blank","rel":"noopener noreferrer","className":"external-link-in-content","children":"Amdahl's law"}],"), and it doesn't necessarily make a correct one. That's why we optimize the whole stack at once rather than individual components."]}]
e:["$","p",null,{"children":"Speed only counts if correct model behavior is preserved, and that can be subtle to check. Customizations can quietly alter model outputs, yet still give the same accuracy on standard benchmarks like GSM8K or GPQA. We use stringent distribution-matching checks rather than functional tests or benchmark scores."}]
f:["$","p",null,{"children":"Our agents learn over time. Every experiment produces reusable insights that the agents use to improve their invention process across models and workloads. For example, our agents learned to avoid distributed deadlocks that would have cost 44 minutes in unnecessary wait time, generalizing a lesson learned from optimizing DeepSeek v4 Pro applied to GLM 5.2."}]
10:["$","h2",null,{"id":"what-makes-optimizing-inference-systems-hard","children":"What makes optimizing inference systems hard?"}]
11:["$","p",null,{"children":"Agents must consider millions of lines of code containing tunable parameters and algorithm implementations, plus countless server configuration settings, making the search space enormous. Small changes in the right places can produce large gains, but the hard part is finding them and knowing what to prioritize."}]
12:["$","p",null,{"children":"Modern inference systems depend on many interacting factors:"}]
13:["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Software:"}]," OS, kernels (e.g., PTX, CuTeDSL, CUDA C, and Triton), high-level scripting (e.g., PyTorch), Python glue code, runtime, scheduling, caching, load balancing, interconnect, client-server configurations."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Hardware:"}]," GPU, CPU, memory, disk, intra- and inter-node connectivity."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Runtime dynamics:"}]," input distributions, caching behavior, memory pressure, throttling, network communication."]}],"\n"]}]
14:["$","p",null,{"children":"Because these systems are highly dynamic, optimizing them requires continuous evaluation and profiling; static code analysis is not enough. But end-to-end evaluations are slow and computationally expensive: a single one can take hours, spanning compilation, server launch, warm-up, and request processing."}]
15:["$","p",null,{"children":"As the agents continually iterate on evaluation results, our evaluation system uses a hierarchical decomposition of end-to-end and micro benchmarks to keep feedback loops short."}]
16:["$","h2",null,{"id":"the-invention-loop","children":"The invention loop"}]
17:["$","p",null,{"children":"Our co-inventors run a rigorous discover + build → evaluate → verify → self-improve loop using many agents in parallel. They explore and implement optimization strategies, evaluate whether each speedup is real, verify that it preserves the model's outputs, and distill what they learn for the next run."}]
18:["$","$L3c",null,{}]
19:["$","h3",null,{"id":"discover-and-build","children":"Discover and build"}]
1a:["$","p",null,{"children":"Our agents propose optimization strategies using dynamic profiling, static analysis, and learned experiences via a self-improvement mechanism. They prioritize optimization targets by weighing potential speedups against the impact on numerical accuracy. This narrows the search space and helps balance exploration versus exploitation."}]
1b:["$","h3",null,{"id":"evaluate","children":"Evaluate"}]
1c:["$","p",null,{"children":"Our agents get feedback from evaluations in a sandbox that replicates the real production serving environment. There, they test customized vLLM serving stacks, dispatching to their own optimized kernels and code in place of the stock implementations."}]
1d:["$","p",null,{"children":"For models with hundreds of billions to trillions of parameters running on complex workloads, measurement is slow and inherently noisy. Shifts in batching behavior and hardware effects like GPU power throttling introduce variance in performance evaluations."}]
1e:["$","p",null,{"children":"An agent optimizing against noisy evaluations will report speedups that are not real. We identify and mitigate sources of measurement noise to ensure that the agent gets clean feedback while optimizing. We then apply statistical analysis and anti-cheating checks so that a measured gain holds up in production."}]
1f:["$","h3",null,{"id":"verify","children":"Verify"}]
20:["$","p",null,{"children":"A speedup is only useful if it sufficiently preserves the model's behavior. Small output errors can compound over long sequences, degrading quality."}]
21:["$","p",null,{"children":["We use a stringent correctness check based on model output distribution matching. These checks involve statistical consistency tests on token-level probability distributions between the optimized model and the stock model. We evaluate this across a diverse multilingual corpus of prompts from the ",["$","a",null,{"href":"https://huggingface.co/datasets/allenai/c4","target":"_blank","rel":"noopener noreferrer","className":"external-link-in-content","children":"AllenAI Common Crawl C4 dataset"}],"."]}]
22:["$","p",null,{"children":["Verification cadence matters as well: too frequent wastes compute, and too rare lets agents drift off track. A validated evaluation method makes fast, trustworthy iteration possible. This is the same thorough philosophy behind our ",["$","a",null,{"href":"/asari-website-proposal/insights/migrating-c-to-rust","target":"$undefined","rel":"$undefined","className":"$undefined","children":"Safe Rust migration work"}],"."]}]
23:["$","h3",null,{"id":"self-improve","children":"Self-improve"}]
24:["$","p",null,{"children":"Our agents distill insights from their experiments and reuse them across models, updating their own reasoning, tactics, and knowledge over time. These insights go beyond basic fact-retrieval: the agents use their experience to change their own workflow and discovery process."}]
25:["$","div",null,{"className":"mt-2 mb-2 flex w-full justify-center","children":["$","div",null,{"className":"w-full max-w-3xl","children":["$","$L3d",null,{}]}]}]
26:["$","h2",null,{"id":"optimization-examples","children":"Optimization examples"}]
27:["$","$L39",null,{"id":"2","children":[["$","p",null,{"children":["Our co-inventors optimize several targets that work together: custom kernels, kernel fusion, parallelism tactics, launch overhead, etc. Most optimizations target niches like M=1 skinny GEMM kernels and glue-code changes that have no equivalent in upstream vLLM through v0.26.",["$","$L3a",null,{}]," See below for an example agent run on GLM 5.2 at concurrency = 1."]}],["$","$L3b",null,{"children":"Some of the recent upstream updates to vLLM target similar kernel optimizations our agents found independently, but the designs of the implementation differ heavily."}]]}]
28:["$","$L3e",null,{}]
29:["$","$L3f",null,{}]
2a:["$","$L40",null,{}]
2b:["$","h2",null,{"id":"looking-ahead","children":"Looking ahead"}]
2c:["$","p",null,{"children":"We are building agents that work on practical system design and optimization. This requires them to work reliably over long time horizons, with the highest levels of rigor."}]
2d:["$","p",null,{"children":"Our co-invention process compounds, driven by these reinforcing elements:"}]
2e:["$","ol",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Accurate observations"}]," about the full system in the loop enable agents to reason about system-level improvements."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Correctness"}]," makes each performance gain shippable and a source of meaningful insights."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Autonomy"}]," lets the agents search a space too large for humans to explore alone."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Learning"}]," carries these insights forward, so each run gives the agents more experience to draw from."]}],"\n"]}]
2f:["$","p",null,{"children":"Scalable verification remains an open problem, and advancing it is necessary to make autonomous optimization practical at frontier scale. We enforced a tight numerical tolerance in this early phase, which gives us a solid foundation to generalize to broader notions of correctness."}]
30:["$","p",null,{"children":"Our agents can optimize under more general approximation tolerances. We are actively applying our co-inventors across different use cases and deployment patterns."}]
31:["$","p",null,{"children":["If you want our agents to optimize your high-performance systems, contact us at ",["$","a",null,{"href":"mailto:hello@asari.ai","target":"$undefined","rel":"$undefined","className":"$undefined","children":"hello@asari.ai"}],"."]}]
32:["$","p",null,{"children":["If you're passionate about building agents that ship verified systems code, ",["$","a",null,{"href":"https://jobs.ashbyhq.com/asari.ai","target":"_blank","rel":"noopener noreferrer","className":"external-link-in-content","children":"join us!"}]]}]
33:["$","div",null,{"className":"flex w-full justify-center","children":["$","$L41",null,{}]}]
34:["$","div",null,{"className":"hidden w-0 shrink-0 xl:block xl:w-64"}]
35:["$","$L42",null,{"children":["$L43",["$","$L44",null,{"promise":"$@45"}]]}]
