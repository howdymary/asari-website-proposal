D73A49"},"children":"=="}],["$","span",null,{"style":{"color":"#24292E"},"children":" State."}],["$","span",null,{"style":{"color":"#005CC5"},"children":"BEGIN_UNIT_TEST"}],["$","span",null,{"style":{"color":"#24292E"},"children":":"}]]}],"\n",["$","span",null,{"data-line":"","children":[["$","span",null,{"style":{"color":"#24292E"},"children":"        unit_test_score "}],["$","span",null,{"style":{"color":"#D73A49"},"children":"="}],["$","span",null,{"style":{"color":"#24292E"},"children":" run_unit_test(frame["}],["$","span",null,{"style":{"color":"#032F62"},"children":"\"target_fn\""}],["$","span",null,{"style":{"color":"#24292E"},"children":"])"}]]}],"\n",["$","span",null,{"data-line":"","children":[["$","span",null,{"style":{"color":"#24292E"},"children":"        frame["}],["$","span",null,{"style":{"color":"#032F62"},"children":"\"source_fn\""}],["$","span",null,{"style":{"color":"#24292E"},"children":"] "}],["$","span",null,{"style":{"color":"#D73A49"},"children":"="}],["$","span",null,{"style":{"color":"#005CC5"},"children":" next"}],["$","span",null,{"style":{"color":"#24292E"},"children":"(frame["}],["$","span",null,{"style":{"color":"#032F62"},"children":"\"source\""}],["$","span",null,{"style":{"color":"#24292E"},"children":"])"}]]}],"\n",["$","span",null,{"data-line":"","children":[["$","span",null,{"style":{"color":"#D73A49"},"children":"        return"}],"$L48","$L49","$L4a"]}]]}]}]}]
2a:["$","p",null,{"children":"However, this approach has multiple drawbacks that prevents this style of coding from scaling to complex workflows."}]
2b:["$","ul",null,{"children":["\n",["$","li",null,{"children":"The order of execution of different parts of the program is no longer obvious from the code, especially when the workflow employs control-flow structures like if/else statements and loops."}],"\n",["$","li",null,{"children":["Using a dictionary ",["$","code",null,{"children":"frame"}]," that carries the state and real-time program data makes it difficult to know whether a data field exists at any point, leading to runtime ",["$","code",null,{"children":"KeyError"}],"s that are hard to debug."]}],"\n",["$","li",null,{"children":["Because runtime variables are accessed through the ",["$","code",null,{"children":"frame"}]," dictionary, linters and static type checkers no longer work, making it impossible to check for type errors."]}],"\n",["$","li",null,{"children":"Simple changes such as increasing or decreasing the step granularity requires structural changes to the state machine, creating more opportunities for bugs."}],"\n"]}]
2c:["$","figure",null,{"data-rehype-pretty-code-figure":"","children":["$","pre",null,{"style":{"backgroundColor":"#fff","color":"#24292e"},"tabIndex":"0","data-language":"python","data-theme":"github-light","children":["$","code",null,{"children":[["$","span",null,{"data-line":"","children":["$","span",null,{"style":{"color":"#6F42C1"},"children":"@encompass.compile"}]}],"\n",["$","span",null,{"data-line":"","children":[["$","span",null,{"style":{"color":"#D73A49"},"children":"def"}],["$","span",null,{"style":{"color":"#6F42C1"},"children":" translate_functions"}],["$","span",null,{"style":{"color":"#24292E"},"children":"(source):"}]]}],"\n",["$","span",null,{"data-line":"","children":[["$","span",null,{"style":{"color":"#D73A49"},"children":"    for"}],["$","span",null,{"style":{"color":"#24292E"},"children":" source_fn "}],["$","span",null,{"style":{"color":"#D73A49"},"children":"in"}],["$","span",null,{"style":{"color":"#24292E"},"children":" source:"}]]}],"\n",["$","span",null,{"className":"highlighted","data-line":"","data-highlighted-line":"","children":["$","span",null,{"style":{"color":"#24292E"},"children":"\t\tbranchpoint()"}]}],"\n",["$","span",null,{"data-line":"","children":[["$","span",null,{"style":{"color":"#24292E"},"children":"\t\ttarget_fn "}],["$","span",null,{"style":{"color":"#D73A49"},"children":"="}],["$","span",null,{"style":{"color":"#24292E"},"children":" translate(source_fn)"}]]}],"\n",["$","span",null,{"data-line":"","children":[["$","span",null,{"style":{"color":"#24292E"},"children":"\t\tcompile_success "}],["$","span",null,{"style":{"color":"#D73A49"},"children":"="}],["$","span",null,{"style":{"color":"#005CC5"},"children":" compile"}],["$","span",null,{"style":{"color":"#24292E"},"children":"(target_fn)"}]]}],"\n",["$","span",null,{"className":"highlighted","data-line":"","data-highlighted-line":"","children":["$","span",null,{"style":{"color":"#24292E"},"children":"\t\trecord_score(compile_success)"}]}],"\n",["$","span",null,{"data-line":"","children":" "}],"\n",["$","span",null,{"className":"highlighted","data-line":"","data-highlighted-line":"","children":["$","span",null,{"style":{"color":"#24292E"},"children":"\t\tbranchpoint()"}]}],"\n",["$","span",null,{"data-line":"","children":[["$","span",null,{"style":{"color":"#24292E"},"children":"\t\tunit_test_score "}],["$","span",null,{"style":{"color":"#D73A49"},"children":"="}],["$","span",null,{"style":{"color":"#24292E"},"children":" run_unit_test(target_fn)"}]]}],"\n",["$","span",null,{"className":"highlighted","data-line":"","data-highlighted-line":"","children":["$","span",null,{"style":{"color":"#24292E"},"children":"\t\trecord_score(unit_test_score)"}]}]]}]}]}]
2d:["$","p",null,{"children":[["$","span",null,{"className":"","style":{"fontVariant":"small-caps"},"children":"EnCompass"}]," addresses these limitations by separating\nsearch from workflow logic. We added ",["$","strong",null,{"children":["$","code",null,{"children":"branchpoint()"}]}]," markers to the two key\nphases—translation and testing—where the agent calls the LLM and we want to\nexplore different possible solutions. With the workflow unchanged, we\nexperimented with multiple search strategies by simply adjusting a few search\nparameters:"]}]
2e:["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Global best-of-N"}],": Run the entire translation N times, keep the best result"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Local best-of-N"}],": Apply best-of-N at each step (per Java class or method)"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Beam search"}],": A generalization of both approaches with configurable beam width and branching factor"]}],"\n"]}]
2f:["$","p",null,{"children":"Beam search bridges the gap between local and global strategies. By sampling and filtering at each step (like local best-of-N), it reduces compounding errors. By maintaining multiple beams (unlike local best-of-N's single path), it avoids locally optimal decisions that are globally suboptimal. Our experiments confirmed this: beam search with both beam width and branching factor greater than one achieved better scaling than either global or local best-of-N alone."}]
30:["$","p",null,{"children":["Moreover, ",["$","span",null,{"className":"","style":{"fontVariant":"small-caps"},"children":"EnCompass"}]," enables mixing search strategies at different levels of granularity within the same workflow. In our code translation example, we found that applying beam search at the class level as well as the method level yielded the best performance, demonstrating the value of fine-grained control over search implementation details."]}]
31:["$","$L4b",null,{"width":800,"height":500,"caption":["Results of using ",["$","span",null,{"className":"","style":{"fontVariant":"small-caps"},"children":"EnCompass"}]," to apply different inference-time scaling methods to the code repository translation agent on MIT OCW 6.005 homework 0. Self-validation is the average pass rate of the unit tests (from the agent's unit testing steps) across all translated methods. Note that cost is shown on a log-scale, as is standard practice. All error bars show standard errors of the mean over 5 runs."]}]
32:["$","p",null,{"children":["Beam search is also the most difficult of these three strategies to implement without ",["$","span",null,{"className":"","style":{"fontVariant":"small-caps"},"children":"EnCompass"}],". The traditional approaches might use explicit state machines or hard-coded beams of program states, which are cumbersome and suffer from the issues described earlier. By making a greater range of search strategies practical to implement and experiment with, ",["$","span",null,{"className":"","style":{"fontVariant":"small-caps"},"children":"EnCompass"}]," unlocks approaches that would otherwise be too complex to attempt, potentially revealing better scaling laws."]}]
33:["$","h2",null,{"id":"conclusion","children":"Conclusion"}]
34:["$","p",null,{"children":["Efficient and reliable reasoning is the foundation for AI systems that can tackle long-horizon, open-ended tasks. ",["$","span",null,{"className":"","style":{"fontVariant":"small-caps"},"children":"EnCompass"}]," rethinks how AI agents search by separating what agents do from how they explore solutions, turning sophisticated search strategies into a composable part of agent design. By bridging the gap between human intent and reliable execution, ",["$","span",null,{"className":"","style":{"fontVariant":"small-caps"},"children":"EnCompass"}]," makes it easier to build AI systems that can serve as true collaborators in discovery and invention."]}]
35:["$","p",null,{"children":["We view ",["$","span",null,{"className":"","style":{"fontVariant":"small-caps"},"children":"EnCompass"}]," as a building block in a broader effort to make intelligent systems more trustworthy, efficient, and creative. Designing and evaluating more general search strategies remains an open and critical area of AI research. Search at scale is fundamental to learning, discovery, invention, and ultimately how intelligent systems push the boundaries of what is possible."]}]
36:["$","p",null,{"children":"If you're interested in building AI agents at the frontier or exploring these ideas further, we'd love to hear from you at hello@asari.ai."}]
37:["$","p",null,{"children":["You can read the full research paper ",["$","a",null,{"href":"https://arxiv.org/abs/2512.03571","target":"_blank","rel":"noopener noreferrer","className":"external-link-in-content","children":"here"}],"."]}]
