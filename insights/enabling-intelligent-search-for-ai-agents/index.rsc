2857142857142,"y":210,"style":{"color":"var(--color-muted)","size":3.5,"opacity":0.6}}],"addEdges":[{"from":"7-2","to":"8-0","style":{"color":"var(--color-muted)","strokeWidth":1,"opacity":0.6}},{"from":"7-2","to":"8-1","style":{"color":"var(--color-muted)","strokeWidth":1,"opacity":0.6}},{"from":"7-2","to":"8-2","style":{"color":"var(--color-muted)","strokeWidth":1,"opacity":0.6}},{"from":"7-9","to":"8-3","style":{"color":"var(--color-muted)","strokeWidth":1,"opacity":0.6}},{"from":"7-9","to":"8-4","style":{"color":"var(--color-muted)","strokeWidth":1,"opacity":0.6}},{"from":"7-9","to":"8-5","style":{"color":"var(--color-muted)","strokeWidth":1,"opacity":0.6}}]},{"addNodes":[{"id":"0-0","x":230,"y":34,"style":{"color":"var(--color-brand-secondary)","size":7,"opacity":1}}],"addEdges":[{"from":"0-0","to":"1-1","style":{"color":"var(--color-brand-secondary)","strokeWidth":1.5,"opacity":1}}],"setText":"This shows how backtracking allows the search to recover from early mistakes."},{"addNodes":[{"id":"1-1","x":230,"y":56,"style":{"color":"var(--color-brand-secondary)","size":7,"opacity":1}}],"addEdges":[{"from":"1-1","to":"2-3","style":{"color":"var(--color-brand-secondary)","strokeWidth":1.5,"opacity":1}}]},{"addNodes":[{"id":"2-3","x":262.85714285714283,"y":78,"style":{"color":"var(--color-brand-secondary)","size":7,"opacity":1}}],"addEdges":[{"from":"2-3","to":"3-5","style":{"color":"var(--color-brand-secondary)","strokeWidth":1.5,"opacity":1}}]},{"addNodes":[{"id":"3-5","x":306.6666666666667,"y":100,"style":{"color":"var(--color-brand-secondary)","size":7,"opacity":1}}],"addEdges":[{"from":"3-5","to":"4-3","style":{"color":"var(--color-brand-secondary)","strokeWidth":1.5,"opacity":1}}]},{"addNodes":[{"id":"4-3","x":262.85714285714283,"y":122,"style":{"color":"var(--color-brand-secondary)","size":7,"opacity":1}}],"addEdges":[{"from":"4-3","to":"5-9","style":{"color":"var(--color-brand-secondary)","strokeWidth":1.5,"opacity":1}}]},{"addNodes":[{"id":"5-9","x":270.5882352941176,"y":144,"style":{"color":"var(--color-brand-secondary)","size":7,"opacity":1}}],"addEdges":[{"from":"5-9","to":"6-6","style":{"color":"var(--color-brand-secondary)","strokeWidth":1.5,"opacity":1}}]},{"addNodes":[{"id":"6-6","x":292.72727272727275,"y":166,"style":{"color":"var(--color-brand-secondary)","size":7,"opacity":1}}],"addEdges":[{"from":"6-6","to":"7-9","style":{"color":"var(--color-brand-secondary)","strokeWidth":1.5,"opacity":1}}]},{"addNodes":[{"id":"7-9","x":270.5882352941176,"y":188,"style":{"color":"var(--color-brand-secondary)","size":7,"opacity":1}}],"addEdges":[{"from":"7-9","to":"8-3","style":{"color":"var(--color-brand-secondary)","strokeWidth":1.5,"opacity":1}}]},{"addNodes":[{"id":"8-3","x":262.85714285714283,"y":210,"style":{"color":"var(--color-brand-secondary)","size":7,"opacity":1}}]},{"addNodes":[],"addEdges":[]},{"addNodes":[],"addEdges":[]},{"addNodes":[],"addEdges":[]},{"addNodes":[],"addEdges":[]}]},"loop":true,"autoPlay":true,"showControls":false,"caption":"$L3e"}]
b:["$","h2",null,{"id":"search-complexity-in-multi-step-reasoning","children":"Search complexity in multi-step reasoning"}]
c:["$","p",null,{"children":"Our work is focused on a future in which AI agents can autonomously work through multi-step tasks like designing engineering projects or building layered, interconnected systems. Such workflows require chaining together hundreds or more reasoning steps and interaction. This creates two fundamental challenges."}]
d:["$","p",null,{"children":"First, the possible paths that the agent could take grow exponentially. Most AI agents use large neural networks, including non-deterministic large language models (LLMs), which don't always give the same answer to the same question. As agents reason for longer, the number of potential paths explodes. Since agents can't feasibly evaluate every option, they need efficient search strategies to find good solutions."}]
e:["$","p",null,{"children":"Second, errors compound. Each step adds uncertainty, and small errors accumulate quickly. When each step depends on previous ones being correct, even a 95% success rate per step means overall success plummets to virtually zero."}]
f:["$","p",null,{"children":["Addressing these challenges requires better tools for building AI agents that can search intelligently. ",["$","span",null,{"className":"","style":{"fontVariant":"small-caps"},"children":"EnCompass"}]," focuses specifically on \"program-in-control\" agents, which are systems where the agent's workflow is (in part) defined programmatically in code. In these systems, developers typically hard-code search strategies directly into each agent's workflow, wrapping parts of it in for/while loops to implement resampling or iterative refinement. This approach has serious limitations: strategies like resampling don't scale well as workflows get longer, while techniques like tree search over the agent's execution paths become practically impossible to implement. The tight coupling between workflow and search also makes strategies difficult to test, swap out, or improve."]}]
10:["$","p",null,{"children":[["$","span",null,{"className":"","style":{"fontVariant":"small-caps"},"children":"EnCompass"}]," addresses this by separating agent workflow\nspecification from search strategy. Developers can define what their agent does\nin clean, readable code, then apply varied search strategies without rewriting\nthe workflow itself. Crucially, this enables search strategies that are more\nsophisticated and contextual than traditional approaches, which can leverage\ninformation across the entire execution history and adapt dynamically to the\nagent's progress."]}]
11:["$","h2",null,{"id":"understanding-cascading-uncertainty","children":"Understanding cascading uncertainty"}]
12:["$","p",null,{"children":"Imagine an AI agent trapped in an escape room. To escape, it must solve four puzzles in order: decode a cipher, solve a logic grid, answer a riddle, and enter a final combination lock. Each puzzle depends on information from previous ones."}]
13:["$","p",null,{"children":"The agent calls an LLM to solve each puzzle. After each puzzle attempt, an evaluation function provides feedback, either graded (e.g. fraction of cipher symbols decoded, number of grid cells correct) or binary (i.e. answer is right or wrong). These scores help the agent gauge progress, but don't guarantee later success."}]
14:["$","p",null,{"children":"Because LLMs are non-deterministic, they can produce answers that seem reasonable but are actually incorrect. The cipher might be decoded in a way that scores well but is fundamentally wrong. The logic grid then builds on this flawed foundation, managing to score 80% correct by chance or partial alignment. Only when the agent reaches the riddle, which gives clear pass/fail feedback rather than partial scores, does it become obvious that something went wrong earlier in the sequence. The agent must then backtrack to reconsider earlier decisions."}]
15:["$","p",null,{"children":"This cascading uncertainty is what makes multi-step reasoning difficult: early mistakes aren't immediately obvious, but they compound and eventually cause failure in downstream steps that depend on them."}]
16:["$","p",null,{"children":"Now imagine twenty puzzles in sequence, or fifty. Each puzzle depends on previous solutions, and each has multiple possible interpretations. The search space of possible paths multiplies rapidly. Since early mistakes can be obscured by plausible partial solutions, the agent must explore many different paths before finding one that works."}]
17:["$","p",null,{"children":"To see why this matters, let's look at the escape room solution in Python pseudocode:"}]
18:["$","figure",null,{"data-rehype-pretty-code-figure":"","children":["$","pre",null,{"style":{"backgroundColor":"#fff","color":"#24292e"},"tabIndex":"0","data-language":"python","data-theme":"github-light","children":["$","code",null,{"children":[["$","span",null,{"data-line":"","children":[["$","span",null,{"style":{"color":"#D73A49"},"children":"def"}],["$","span",null,{"style":{"color":"#6F42C1"},"children":" solve_escape_room"}],["$","span",null,{"style":{"color":"#24292E"},"children":"():"}]]}],"\n",["$","span",null,{"data-line":"","children":[["$","span",null,{"style":{"color":"#24292E"},"children":"    cipher "}],["$","span",null,{"style":{"color":"#D73A49"},"children":"="}],["$","span",null,{"style":{"color":"#24292E"},"children":" solve_cipher()"}]]}],"\n",["$","span",null,{"data-line":"","children":[["$","span",null,{"style":{"color":"#24292E"},"children":"    logic "}],["$","span",null,{"style":{"color":"#D73A49"},"children":"="}],["$","span",null,{"style":{"color":"#24292E"},"children":" solve_logic(cipher)"}]]}],"\n",["$","span",null,{"data-line":"","children":[["$","span",null,{"style":{"color":"#24292E"},"children":"    riddle "}],["$","span",null,{"style":{"color":"#D73A49"},"children":"="}],["$","span",null,{"style":{"color":"#24292E"},"children":" solve_riddle(cipher, logic)"}]]}],"\n",["$","span",null,{"data-line":"","children":[["$","span",null,{"style":{"color":"#24292E"},"children":"    code "}],["$","span",null,{"style":{"color":"#D73A49"},"children":"="}],["$","span",null,{"style":{"color":"#24292E"},"children":" solve_combination(cipher, logic, riddle)"}]]}],"\n",["$","span",null,{"data-line":"","children":["$","span",null,{"style":{"color":"#24292E"},"children":"    open_door(code)"}]}]]}]}]}]
19:["$","p",null,{"children":"This clearly expresses what the agent should do. However, finding the solution using non-deterministic LLMs is where traditional programming becomes cumbersome. You would have to write complicated loops to try each puzzle multiple times, manually track which attempts were successful, and hard-code rules for when and where to backtrack."}]
1a:["$","figure",null,{"data-rehype-pretty-code-figure":"","children":["$","pre",null,{"style":{"backgroundColor":"#fff","color":"#24292e"},"tabIndex":"0","data-language":"python","data-theme":"github-light","children":["$","code",null,{"children":[["$","span",null,{"data-line":"","children":[["$","span",null,{"style":{"color":"#D73A49"},"children":"def"}],["$","span",null,{"style":{"color":"#6F42C1"},"children":" solve_escape_room"}],["$","span",null,{"style":{"color":"#24292E"},"children":"():"}]]}],"\n",["$","span",null,{"data-line":"","children":" "}],"\n",["$","span",null,{"data-line":"","children":["$","span",null,{"style":{"color":"#6A737D"},"children":"    # Try the cipher multiple times"}]}],"\n",["$","span",null,{"data-line":"","children":[["$","span",null,{"style":{"color":"#24292E"},"children":"    cipher_solutions "}],["$","span",null,{"style":{"color":"#D73A49"},"children":"="}],["$","span",null,{"style":{"color":"#24292E"},"children":" []"}]]}],"\n",["$","span",null,{"data-line":"","children":[["$","span",null,{"style":{"color":"#D73A49"},"children":"    for"}],["$","span",null,{"style":{"color":"#24292E"},"children":" attempt "}],["$","span",null,{"style":{"color":"#D73A49"},"children":"in"}],["$","span",null,{"style":{"color":"#005CC5"},"children":" range"}],["$","span",null,{"style":{"color":"#24292E"},"children":"(N):"}]]}],"\n",["$","span",null,{"data-line":"","children":[["$","span",null,{"style":{"color":"#24292E"},"children":"        candidate "}],["$","span",null,{"style":{"color":"#D73A49"},"children":"="}],["$","span",null,{"style":{"color":"#24292E"},"children":" llm.solve_cipher()"}]]}],"\n",["$","span",null,{"data-line":"","children":[["$","span",null,{"style":{"color":"#24292E"},"children":"        score "}],["$","span",null,{"style":{"color":"#D73A49"},"children":"="}],["$","span",null,{"style":{"color":"#24292E"},"children":" evaluate_cipher(candidate)"}]]}],"\n",["$","span",null,{"data-line":"","children":["$","span",null,{"style":{"color":"#24292E"},"children":"        cipher_solutions.append((candidate, score))"}]}],"\n",["$","span",null,{"data-line":"","children":" "}],"\n",["$","span",null,{"data-line":"","children":[["$","span",null,{"style":{"color":"#24292E"},"children":"    best_cipher, best_cipher_score "}],["$","span",null,{"style":{"color":"#D73A49"},"children":"="}],["$","span",null,{"style":{"color":"#005CC5"},"children":" max"}],["$","span",null,{"style":{"color":"#24292E"},"children":"(cipher_solutions, "}],["$","span",null,{"style":{"color":"#E36209"},"children":"key"}],["$","span",null,{"style":{"color":"#D73A49"},"children":"=lambda"}],["$","span",null,{"style":{"color":"#24292E"},"children":" x: x["}],["$","span",null,{"style":{"color":"#005CC5"},"children":"1"}],["$","span",null,{"style":{"color":"#24292E"},"children":"])"}]]}],"\n",["$","span",null,{"data-line":"","children":" "}],"\n",["$","span",null,{"data-line":"","children":["$","span",null,{"style":{"color":"#6A737D"},"children":"    # Now try the logic puzzle multiple times"}]}],"\n",["$","span",null,{"data-line":"","children":[["$","span",null,{"style":{"color":"#24292E"},"children":"    logic_solutions "}],["$","span",null,{"style":{"color":"#D73A49"},"children":"="}],["$","span",null,{"style":{"color":"#24292E"},"children":" []"}]]}],"\n",["$","span",null,{"data-line":"","children":[["$","span",null,{"style":{"color":"#D73A49"},"children":"    for"}],["$","span",null,{"style":{"color":"#24292E"},"children":" attempt "}],["$","span",null,{"style":{"color":"#D73A49"},"children":"in"}],["$","span",null,{"style":{"color":"#005CC5"},"children":" range"}],["$","span",null,{"style":{"color":"#24292E"},"children":"(N):"}]]}],"\n",["$","span",null,{"data-line":"","children":[["$","span",null,{"style":{"color":"#24292E"},"children":"        candidate "}],["$","span",null,{"style":{"color":"#D73A49"},"children":"="}],["$","span",null,{"style":{"color":"#24292E"},"children":" llm.solve_logic(best_cipher)"}]]}],"\n",["$","span",null,{"data-line":"","children":[["$","span",null,{"style":{"color":"#24292E"},"children":"        score "}],["$","span",null,{"style":{"color":"#D73A49"},"children":"="}],["$","span",null,{"style":{"color":"#24292E"},"children":" evaluate_logic(candidate)"}]]}],"\n",["$","span",null,{"data-line":"","children":["$","span",null,{"style":{"color":"#24292E"},"children":"        logic_solutions.append((candidate, score))"}]}],"\n",["$","span",null,{"data-line":"","children":" "}],"\n",["$","span",null,{"data-line":"","children":[["$","span",null,{"style":{"color":"#24292E"},"children":"    best_logic, best_logic_score "}],["$","span",null,{"style":{"color":"#D73A49"},"children":"="}],["$","span",null,{"style":{"color":"#005CC5"},"children":" max"}],["$","span",null,{"style":{"color":"#24292E"},"children":"(logic_solutions, "}],["$","span",null,{"style":{"color":"#E36209"},"children":"key"}],["$","span",null,{"style":{"color":"#D73A49"},"children":"=lambda"}],["$","span",null,{"style":{"color":"#24292E"},"children":" x: x["}],["$","span",null,{"style":{"color":"#005CC5"},"children":"1"}],["$","span",null,{"style":{"color":"#24292E"},"children":"])"}]]}],"\n",["$","span",null,{"data-line":"","children":" "}],"\n",["$","span",null,{"data-line":"","children":["$L3f","$L40","$L41","$L42","$L43"]}],"\n","$L44","\n","$L45"]}]}]}]
1b:["$","p",null,{"children":"This approach quickly becomes unmanageable as the agent grows complex. Each additional puzzle requires more convoluted search logic for resampling and backtracking. Moreover, the search logic becomes intertwined with the problem-solving code, making it nearly impossible to swap in different search strategies or parallelize exploration without rewriting core logic. The result is a brittle, monolithic system that resists iteration and experimentation, which is exactly what you don't want when building agents with non-deterministic LLMs."}]
1c:["$","h2",null,{"id":"decoupling-logic-from-search","children":"Decoupling logic from search"}]
1d:["$","p",null,{"children":[["$","span",null,{"className":"","style":{"fontVariant":"small-caps"},"children":"EnCompass"}]," solves these problems by separating the two key\naspects of agent programming: the underlying workflow and the search strategy.\nInstead of hardcoding search logic, you simply mark decision points with\n",["$","strong",null,{"children":["$","code",null,{"children":"branchpoint()"}]}]," and evaluation points with ",["$","strong",null,{"children":["$","code",null,{"children":"record_score()"}]}],"."]}]
1e:["$","p",null,{"children":["Branchpoints identify non-deterministic actions you may want to revisit. For example, marking each puzzle as a branchpoint lets you attempt the cipher multiple times or return to it after the logic puzzle fails. Scores provide contextual information about which paths are worth exploring. Collectively, these annotations tell ",["$","span",null,{"className":"","style":{"fontVariant":"small-caps"},"children":"EnCompass"}]," where the agent can explore alternatives and how well each path performs, enabling complex search strategies without cluttering the code."]}]
